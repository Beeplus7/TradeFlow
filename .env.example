# TradFlow — Environment Credentials
# Copy to .env and fill in values. Do not commit .env.
# Client-safe values use the EXPO_PUBLIC_ prefix.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# --- Google Auth (OAuth 2.0) ---
# Client ID ends with .apps.googleusercontent.com
# Client Secret starts with GOCSPX- (never reuse DB password)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub (repo / CI / deploy) ---
GITHUB_TOKEN=
GITHUB_OWNER=Beeplus7
GITHUB_REPO=TradeFlow
GITHUB_WEBHOOK_SECRET=

# --- VPS / Deploy ---
VPS_HOST=
VPS_USER=root
VPS_SSH_PORT=22
VPS_DEPLOY_PATH=/var/www/tradflow
VPS_SSH_KEY_PATH=
VPS_INITIAL_PASSWORD=
EXPO_PUBLIC_API_BASE_URL=https://f.reelstorm.uk
EXPO_PUBLIC_APP_URL=https://f.reelstorm.uk

# --- Stripe (test mode · secret stays server/edge only) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_HYBRID=
